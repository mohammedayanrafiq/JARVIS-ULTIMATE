{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jarvis-desktop",
  "version": "1.0.0",
  "identifier": "com.jarvis.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "orb",
        "title": "J.A.R.V.I.S Orb",
        "url": "orb.html",
        "width": 80,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "main",
        "title": "J.A.R.V.I.S — AI Assistant",
        "url": "index.html",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon.png"
    ]
  }
}
